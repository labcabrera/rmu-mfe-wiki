# rmu-mfe-wiki: local development. Copy to .env and run `make start` (or F5 in VS Code).
#
# webpack loads `.env.<mode>` first (for example `.env.development`) and falls back to `.env`.
# The RMU_* values are not baked into the bundle: the dev server serves them as /env-config.js
# (keys listed in public/env-config.template.js). They only apply when the wiki is opened standalone
# on http://localhost:8085. Inside the shell (http://localhost, through the rmu-platform gateway)
# the shell's configuration is used instead.

# --- Dev server --------------------------------------------------------------------------------
PORT=8085

# --- Static assets -----------------------------------------------------------------------------
# Images and locales. Through the gateway: /mfe/assets/ (rmu-mfe-assets container).
RMU_MFE_ASSETS_URI=http://localhost/mfe/assets/
