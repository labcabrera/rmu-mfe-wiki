{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug wiki in the shell (gateway)",
      "detail": "Stop the container first: `make mfe-dev s=wiki` in rmu-platform",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost/wiki",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "start:live",
      "sourceMapPathOverrides": {
        "webpack://wiki/./*": "${workspaceFolder}/*"
      }
    },
    {
      "name": "Debug wiki standalone (:8085)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8085",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "start:live",
      "sourceMapPathOverrides": {
        "webpack://wiki/./*": "${workspaceFolder}/*"
      }
    }
  ]
}
